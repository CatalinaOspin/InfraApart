// ============================================================
// Schema Prisma de InfraApart
// Fuente de verdad del modelo: docs/database_schema.sql
// Generar el cliente: npx prisma generate (dentro de backend/)
// Sincronizar con la BD real: npx prisma db pull
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Transaction Pooler (PgBouncer, puerto 6543): lo usa Prisma Client en runtime.
  // Para Supabase se recomienda ?pgbouncer=true&connection_limit=1 en DATABASE_URL.
  url       = env("DATABASE_URL")
  // Conexión directa (puerto 5432): la usa el CLI de Prisma (migrate / db push)
  // para no pasar por PgBouncer.
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enums (equivalentes a los tipos ENUM nativos de PostgreSQL)
// ============================================================

/// user_role
enum UserRole {
  citizen
  admin
}

/// damage_type
enum DamageType {
  pothole
  crack
  flooding
  sidewalk
  signage
  lighting
  drainage
  other
}

/// severity_level
enum SeverityLevel {
  low
  medium
  high
  critical
}

// ============================================================
// Modelos
// ============================================================

/// Usuarios de la plataforma (ciudadanos y administradores)
model User {
  id           Int       @id @default(autoincrement())
  fullName     String    @map("full_name") @db.VarChar(150)
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @default(citizen)
  phone        String?   @db.VarChar(20)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reports Report[]
  changes ReportHistory[] @relation("ChangedBy")

  @@index([isActive])
  @@map("users")
}

/// Categorías de daños viales visibles para el ciudadano
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  description String?   @db.Text
  icon        String?   @db.VarChar(50)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reports Report[]

  @@index([isActive])
  @@map("categories")
}

/// Flujo de estados de un reporte
model ReportStatus {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(30)
  label       String    @db.VarChar(80)
  color       String    @default("#CCCCCC") @db.VarChar(20)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reports        Report[]        @relation("CurrentStatus")
  previousStatus ReportHistory[] @relation("PreviousStatus")
  nextStatus     ReportHistory[] @relation("NewStatus")

  @@index([isActive])
  @@map("report_statuses")
}

/// Reportes de daños viales realizados por ciudadanos.
/// Geolocalización: latitude/longitude (Float) + índice GIST de expresión
/// en la BD (ver docs/database_schema.sql). Para consultas espaciales usar
/// prisma.$queryRaw con ST_DWithin, ST_Distance, ST_AsGeoJSON, etc.
model Report {
  id              Int           @id @default(autoincrement())
  referenceCode   String        @unique @map("reference_code") @db.VarChar(20)
  userId          Int           @map("user_id")
  categoryId      Int           @map("category_id")
  statusId        Int           @default(1) @map("status_id")
  title           String        @db.VarChar(200)
  description     String?       @db.Text
  damageType      DamageType    @map("damage_type")
  severityLevel   SeverityLevel @default(low) @map("severity_level")
  latitude        Float
  longitude       Float
  locationAddress String?       @map("location_address") @db.VarChar(255)
  imageUrl        String?       @map("image_url") @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  category Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status   ReportStatus @relation("CurrentStatus", fields: [statusId], references: [id], onDelete: Restrict)
  history  ReportHistory[]

  @@index([statusId])
  @@index([categoryId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("reports")
}

/// Historial de cambios de estado de cada reporte
model ReportHistory {
  id               Int       @id @default(autoincrement())
  reportId         Int       @map("report_id")
  previousStatusId Int?      @map("previous_status_id")
  newStatusId      Int       @map("new_status_id")
  changedByUserId  Int       @map("changed_by_user_id")
  comment          String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  report    Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  previous  ReportStatus? @relation("PreviousStatus", fields: [previousStatusId], references: [id])
  next      ReportStatus  @relation("NewStatus", fields: [newStatusId], references: [id])
  changedBy User          @relation("ChangedBy", fields: [changedByUserId], references: [id])

  @@index([reportId, createdAt(sort: Desc)])
  @@index([changedByUserId])
  @@index([newStatusId])
  @@map("report_history")
}