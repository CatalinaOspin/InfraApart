# ============================================
# InfraApart Backend - Variables de Entorno (PLANTILLA)
# ============================================
# 1) Copia este archivo a .env y pega los VALORES REALES.
# 2) NUNCA commitees credenciales reales: .env ya está en .gitignore.
# 3) Si una clave se filtró a git, rota la contraseña en Supabase
#    (Project Settings → Database → Reset database password).

# Servidor
PORT=3001
NODE_ENV=development

# ------------------------------------------------------------
# Base de datos PostgreSQL (nube - Supabase)
# ------------------------------------------------------------
# DATABASE_URL → Transaction Pooler (PgBouncer, puerto 6543). Lo usa
#   Prisma Client en runtime. Con pooler se recomienda connection_limit=1.
# DIRECT_URL  → Conexión directa (puerto 5432). La usa el CLI de Prisma
#   (prisma migrate / prisma db push) para no pasar por PgBouncer.
# Obtén ambos strings en: Supabase → Project Settings → Database →
#   Connection string (pestañas "Transaction pooler" y "Direct connection").
# ------------------------------------------------------------
DATABASE_URL="postgresql://TU_USUARIO:TU_CLAVE@TU_HOST.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://TU_USUARIO:TU_CLAVE@TU_HOST.pooler.supabase.com:5432/postgres"

# Referencia para logging (no afecta la conexión de Prisma)
DB_HOST=TU_HOST_DB
DB_PORT=6543
DB_NAME=postgres
DB_USER=TU_USUARIO
DB_PASSWORD=TU_CLAVE

# ------------------------------------------------------------
# Alternativa LOCAL (Docker): descomenta este bloque y comenta el de Supabase
# ------------------------------------------------------------
# DATABASE_URL="postgresql://infraapart_user:infraapart_password@localhost:5432/infraapart_db?schema=public"
# DIRECT_URL="postgresql://infraapart_user:infraapart_password@localhost:5432/infraapart_db?schema=public"
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=infraapart_db
# DB_USER=infraapart_user
# DB_PASSWORD=infraapart_password

# JWT
JWT_SECRET=tu_jwt_secret_super_seguro
JWT_EXPIRES_IN=24h

# CORS
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
