# ============================================
# InfraApart Backend - Variables de Entorno (PLANTILLA)
# ============================================
# 1) Copia este archivo a .env y pega los VALORES REALES.
# 2) NUNCA commitees credenciales reales: .env ya está en .gitignore.
# 3) Si una clave se filtró a git, rótala en Neon
#    (Branch → Roles → Reset password).

# Servidor
PORT=3001
NODE_ENV=development

# ------------------------------------------------------------
# Base de datos PostgreSQL + PostGIS (nube - Neon)
# ------------------------------------------------------------
# DATABASE_URL → conexión con pooler (el host incluye "-pooler"). La usa
#   Prisma Client en runtime.
# DIRECT_URL  → conexión directa (host sin "-pooler"). La usa el CLI de
#   Prisma (prisma migrate) para no pasar por el pooler.
# Obtén ambas en: Neon → Dashboard → Connect (activa/desactiva "Connection pooling").
# ------------------------------------------------------------
DATABASE_URL="postgresql://TU_USUARIO:TU_CLAVE@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://TU_USUARIO:TU_CLAVE@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# Referencia para logging (no afecta la conexión de Prisma)
DB_HOST=ep-XXXX-pooler.REGION.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=TU_USUARIO
DB_PASSWORD=TU_CLAVE

# ------------------------------------------------------------
# Alternativa LOCAL (Docker): descomenta este bloque y comenta el de Neon
# ------------------------------------------------------------
# DATABASE_URL="postgresql://infraapart_user:infraapart_password@localhost:5432/infraapart_db?schema=public"
# DIRECT_URL="postgresql://infraapart_user:infraapart_password@localhost:5432/infraapart_db?schema=public"
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=infraapart_db
# DB_USER=infraapart_user
# DB_PASSWORD=infraapart_password

# JWT
JWT_SECRET=tu_jwt_secret_super_seguro
JWT_EXPIRES_IN=24h

# CORS
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
