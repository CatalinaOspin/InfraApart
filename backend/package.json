{
  "name": "infraapart-backend",
  "version": "1.0.0",
  "description": "API REST para la plataforma InfraApart - Reporte y gestión de daños viales en Apartadó",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "prisma:postgis": "prisma db execute --schema prisma/schema.prisma --file prisma/postgis-supabase.sql",
    "prisma:studio": "prisma studio",
    "db:up": "docker compose -f ../docker-compose.yml up -d",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "db:logs": "docker compose -f ../docker-compose.yml logs -f db",
    "db:test": "ts-node --transpile-only src/scripts/test-db.ts"
  },
  "keywords": [
    "infraapart",
    "infraestructura-vial",
    "apartado",
    "reportes"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.0",
    "eslint": "^8.54.0",
    "prisma": "^6.19.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
