# ============================================
# InfraApart Frontend - Variables de Entorno
# ============================================
# Copiar este archivo a .env y configurar los valores
# NOTA: En Vite las variables deben comenzar con VITE_

# URL base de la API del backend
VITE_API_URL=http://localhost:3001/api

# URL base del mapa (ej. OpenStreetMap tiles)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Límite de reportes por página
VITE_PAGE_SIZE=20